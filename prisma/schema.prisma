generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Module {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  title       String
  order       Int
  description String?
  lessons     Lesson[]
  createdAt   DateTime @default(now())
}

model Lesson {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  slug        String
  title       String
  order       Int
  moduleId    String     @db.ObjectId
  module      Module     @relation(fields: [moduleId], references: [id])
  tasks       Task[]
  theory      Theory[]
  progresses  LessonProgress[]
  createdAt   DateTime   @default(now())

  @@unique([moduleId, slug])
}

model Task {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  number      Int
  name        String   @default("")
  question    String
  options     String[]
  answer      String
  explanation String?
  difficulty  String   @default("easy")
  type           String   @default("quiz")
  starterCode    String?
  language       String?
  expectedOutput String?
  lessonId    String   @db.ObjectId
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  createdAt   DateTime @default(now())
}

model Theory {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  order    Int
  title    String
  content  String
  lessonId String @db.ObjectId
  lesson   Lesson @relation(fields: [lessonId], references: [id])
}

model LessonProgress {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  lessonId        String   @db.ObjectId
  lesson          Lesson   @relation(fields: [lessonId], references: [id])
  completedTasks  String[]
  wrongTasks      String[]
  currentTaskIdx  Int      @default(0)
  currentTheoryIdx Int     @default(0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@unique([userId, lessonId])
}

// Streak / activity tracking. XP & level are derived from LessonProgress, but
// daily activity (for streaks + the heatmap) must be persisted.
model UserStats {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique
  activeDays    String[]                 // YYYY-MM-DD (user-local), unique & sorted
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveDay String   @default("")
  updatedAt     DateTime @updatedAt
}

// Spaced repetition (SM-2). One row per user+task that needs reviewing.
model ReviewItem {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String
  taskId       String   @db.ObjectId
  due          DateTime @default(now())
  intervalDays Int      @default(0)
  ease         Float    @default(2.5)
  reps         Int      @default(0)
  lapses       Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([userId, taskId])
}
